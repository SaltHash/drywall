{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drywall",
  "main": "src/index.js",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },

  // Declares DATABASE_URL as a required secret. During `wrangler dev` its value
  // is read automatically from .env (or .dev.vars); in production set it with
  // `wrangler secret put DATABASE_URL`.
  "secrets": {
    "required": [
      "DATABASE_URL"
    ]
  },

  // The game itself is served as static assets from the same Worker, so the
  // API is same-origin (no CORS) and the connection string never reaches the
  // browser.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // A single Durable Object instance holds the current global message. This
  // gives the dev panel one durable, globally-consistent value to broadcast
  // without persisting announcements in the player database.
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_MESSAGE",
        "class_name": "GlobalMessage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GlobalMessage"
      ]
    }
  ]
}
